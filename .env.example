# GCP Project Configuration
PROJECT_ID=soc-copilot-demo
REGION=us-central1

# BigQuery
BIGQUERY_DATASET=soc

# Firestore
FIRESTORE_DATABASE=(default)

# Neo4j Aura
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# Block 8.5: Graph backend switcher
# GRAPH_BACKEND=neo4j   ← default, uses Neo4j Aura (all vars above)
# GRAPH_BACKEND=age     ← activates PostgreSQL+AGE via ci-platform
# Requires: pip install 'ci-platform[graph]'
GRAPH_BACKEND=neo4j

# PostgreSQL+AGE connection (only required when GRAPH_BACKEND=age)
PG_HOST=localhost
PG_PORT=5432
PG_DB=soc_graph
PG_USER=postgres
PG_PASSWORD=your-pg-password-here

# Vertex AI
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-1.5-pro-002

# Microsoft Sentinel Integration (Block 4.2)
# Required for live alert ingestion from Sentinel.
# Leave blank to run in demo mode (synthetic alerts only).
SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_WORKSPACE_ID=

# Setup instructions:
# 1. Register an app in Azure AD (App registrations)
# 2. Grant API permission: SecurityAlert.Read.All (Application)
# 3. Create client secret, copy values above
# 4. SENTINEL_WORKSPACE_ID = Log Analytics workspace ID (optional)
